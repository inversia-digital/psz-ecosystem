# Supabase (compartido con resto del ecosistema)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=

# PostHog (EU)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Analytics 4
NEXT_PUBLIC_GA4_ID=

# Telegram (webhook al bot Inversia en VPS)
TELEGRAM_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────
# Tracking server-side de visitas + panel /admin/visitas
# Ver: apps/psz/sql/visitor_logs.sql para el schema
# ─────────────────────────────────────────────────────────────────

# Supabase para visitor_logs (puede ser el mismo proyecto que arriba
# o uno dedicado de tracking). SERVICE_KEY = service_role, no la anon.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# URL pública del endpoint de ingest (apunta a la propia web)
VISITS_INGEST_URL=https://psz.es/api/visits/log

# Secret compartido middleware → endpoint. Mín 32 chars random.
# Genera uno con: openssl rand -hex 32
VISITS_INGEST_SECRET=

# Credenciales Basic Auth para /admin/*
ADMIN_USER=admin
ADMIN_PASS=
